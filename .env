# Shop weather — Gujarat (Ahmedabad). and city: lat/lon From Google Maps.
WEATHER_LATITUDE=23.0225
WEATHER_LONGITUDE=72.5714
WEATHER_LOCATION_LABEL=Ahmedabad, Gujarat

# Gmail (Google Account → Security → 2-Step Verification → App passwords)
# As long as both are empty, Django will print emails to the console (runserver terminal).
EMAIL_HOST_USER=saklenmanek5731@gmail.com
EMAIL_HOST_PASSWORD=fyru xjti aoll nzku
DEFAULT_FROM_EMAIL=saklenmanek5731@gmail.com

# Celery: 1 = email runs along with runserver (no need for Redis/worker) — registration is reliable.
# 0 = run Redis + worker so that email is sent in the background.
CELERY_TASK_ALWAYS_EAGER=1
CELERY_BROKER_URL=redis://localhost:6379/0

# Windows — from IMS folder (cd ...\IMS):
# 1) Redis: docker run --rm -p 6379:6379 redis:7-alpine
#    If no Docker: Memurai / WSL Redis / cloud broker → change CELERY_BROKER_URL accordingly
# 2) Worker: venv\Scripts\activate  &&  celery -A InventoryManagementSystem worker -l info
# 3) Django: venv\Scripts\activate  &&  python manage.py runserver
# If Redis is off + EAGER=0 → email falls back to sync mode (check logs), signup still gets saved.




